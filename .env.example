# Copiá este archivo como apps/partner/.env.local y apps/console/.env.local para desarrollo local.
# En Vercel se cargan en Project → Settings → Environment Variables.

# Contraseña del portal de partners (obligatoria en producción).
DEMO_PASSWORD=

# Contraseña de la consola interna. Si no está, usa DEMO_PASSWORD.
CONSOLE_PASSWORD=

# Opcional: secreto para firmar sesiones (32+ caracteres). Si falta, se deriva de la contraseña.
SESSION_SECRET=

# Opcional: client_id de la app OAuth registrada en app.gravl.ai/settings/developer (Coach Studio).
NEXT_PUBLIC_GRAVL_OAUTH_CLIENT_ID=
