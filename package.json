{
  "name": "gravl-b2b",
  "version": "0.2.0",
  "private": true,
  "description": "GRAVL B2B: portal de partners, consola interna y paquetes de dominio compartidos.",
  "engines": {
    "node": ">=20.9"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "concurrently -n partner,console -c \"#C6FF00,#38BDF8\" \"npm:dev:partner\" \"npm:dev:console\"",
    "dev:partner": "npm run dev -w @gravl/partner",
    "dev:console": "npm run dev -w @gravl/console",
    "build": "npm run build -w @gravl/partner && npm run build -w @gravl/console",
    "lint": "npm run lint --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test -w @gravl/domain"
  },
  "devDependencies": {
    "concurrently": "9.1.2",
    "typescript": "^5",
    "tsx": "4.20.6"
  }
}
